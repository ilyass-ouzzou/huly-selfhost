# Huly - example env for Railway Template (do not store secrets here)
HULY_VERSION=v0.7.117
HOST_ADDRESS=example.railway.app
SECRET=changeme_replace_with_secret

# Mongo
MONGO_URL=mongodb://mongo:27017/huly

# MinIO
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=minio_pass
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=huly-files

# Services
ACCOUNTS_URL=http://account:3000
FRONT_URL=http://front:3000
TRANSACTOR_URL=http://transactor:4000

# Elasticsearch (optional)
ELASTIC_URL=http://elasticsearch:9200

# Optional third party (fill if used)
OPENAI_API_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
